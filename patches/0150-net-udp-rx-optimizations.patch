# UDP 接收路径优化（KMI-safe 子集）
#
# 上游来源：Linux 6.18 的 "udp: increase RX performance under stress" 系列
#   (Eric Dumazet / Paolo Abeni，2025-09，merge ce463e435757)
#
#   3fbb2a6f3a70 ipv6: make ipv6_pinfo.saddr_cache a boolean
#   5489f333ef99 ipv6: make ipv6_pinfo.daddr_cache a boolean
#   9fba1eb39e2f ipv6: np->rxpmtu race annotation
#   b76543b21fbc ipv6: reorganise struct ipv6_pinfo
#   9aaec660b5be udp: refine __udp_enqueue_schedule_skb() test
#   faf7b4aefd5b udp: update sk_rmem_alloc before busylock acquisition   <-- 本补丁
#   4effb335b5da net: group sk_backlog and sk_receive_queue
#   9db27c80622b udp: add udp_drops_inc() helper
#   3cd04c8f4afe udp: make busylock per socket                          <-- 本补丁
#   6471658dc66c udp: use skb_attempt_defer_free()
#
# 回移了两条，并保持 KMI/ABI 不变：
#
#   1) faf7b4aefd5b：接近 sk_rcvbuf 时先 atomic_add_return() 计账并做溢出判断，
#      再抢 busylock（溢出的包不再挤锁）；热路径改用无返回值的 atomic_add()。
#
#   2) 3cd04c8f4afe：把全局哈希数组 udp_busylocks 换成 per-socket busylock，
#      消除 NUMA 远端 cacheline 弹跳与哈希碰撞。
#      上游是把 spinlock 加进 struct udp_sock 末尾（会撑大结构、移动
#      udp6_sock.inet6，破坏 ABI）。这里改用 struct sock 的一个空闲
#      KABI reserve 存【指针】：
#          ANDROID_KABI_USE(8, spinlock_t *sk_udp_busylock);
#      锁对象本身在 socket 外单独分配，并用 SLAB_HWCACHE_ALIGN 保证每个
#      分配独占一条 cache line，从而保留上游 ____cacheline_aligned_in_smp
#      的隔离效果；reserve 里只是换成同样 8 字节的指针，struct sock 的
#      size 与所有成员偏移完全不变。
#      分配发生在 ->init()（进程上下文）：udp_init_sock()/udpv6_init_sock()，
#      UDP-Lite v4/v6 转发错误（原代码吞掉了返回值，这里一并修正）；释放
#      在 udp_destruct_common()，对 sk_destruct 失败路径用 NULL 兜底。
#      新增 udp_busylock_alloc 并 EXPORT_SYMBOL_GPL（v6 代码调用，作用同既有的
#      udp_destruct_common）。这是【新增】导出，不删不改任何既有符号，不影响
#      厂商模块；若不喜欢新增导出，可在确认 CONFIG_IPV6=y 后去掉该 EXPORT。
#
# 为什么其余补丁不回移：
#   * 3fbb2a6f3a70 / 5489f333ef99 / b76543b21fbc：改 `struct ipv6_pinfo` 字段
#     类型/顺序，`udp6_sock`/`tcp6_sock`/`raw6_sock` 尾部偏移整体变化。KABI
#     reserve 只能填空，救不了"重排/缩小已有字段"。
#   * 9fba1eb39e2f：5.15.211 里已经是 `rxopt.bits.rxpmtu && READ_ONCE(np->rxpmtu)`。
#   * 9aaec660b5be：依赖 6.x 的 `rcvbuf` 局部变量/"队列为空才收"语义，5.15 无对应代码。
#   * 4effb335b5da：改 `struct sock` 成员顺序，同上，reserve 救不了。
#   * 9db27c80622b：6.x 的 `sk_drop_counters`/`numa_drop_counters` 5.15 不存在。
#   * 6471658dc66c：需回移 5.17 的 per-cpu skb defer-free 基建（`skb->alloc_cpu`），
#     是独立的大件，风险不在字段本身。
#
# 注意：使用 KABI reserve 后，scripts/abi_layout.py 需要把
# "顶层 android_kabi_reservedN 字段"和"ANDROID_KABI_USE 产生的、包裹了
# reserve 的匿名 union"视为同一个 ABI 槽位，否则 BTF diff 会误报。
# 该归一化已一并加入 abi_layout.py。
#
diff --git a/include/net/sock.h b/include/net/sock.h
index 460b6d088..8ddec5a50 100644
--- a/include/net/sock.h
+++ b/include/net/sock.h
@@ -552,7 +552,12 @@ struct sock {
 	ANDROID_KABI_RESERVE(5);
 	ANDROID_KABI_RESERVE(6);
 	ANDROID_KABI_RESERVE(7);
-	ANDROID_KABI_RESERVE(8);
+	/* Per-UDP-socket busylock: points to a cache-line aligned object
+	 * allocated outside struct sock (upstream 6.18 "udp: make busylock
+	 * per socket", 3cd04c8f4afe).  Stored in a KABI reserve so struct
+	 * sock layout/size is unchanged; only UDP sockets use it.
+	 */
+	ANDROID_KABI_USE(8, spinlock_t *sk_udp_busylock);
 };
 
 enum sk_pacing {
diff --git a/include/net/udp.h b/include/net/udp.h
index 3dbfa4cfa..ed54927e0 100644
--- a/include/net/udp.h
+++ b/include/net/udp.h
@@ -299,6 +299,7 @@ void udp4_hwcsum(struct sk_buff *skb, __be32 src, __be32 dst);
 int udp_rcv(struct sk_buff *skb);
 int udp_ioctl(struct sock *sk, int cmd, unsigned long arg);
 int udp_init_sock(struct sock *sk);
+int udp_busylock_alloc(struct sock *sk);
 int udp_pre_connect(struct sock *sk, struct sockaddr *uaddr, int addr_len);
 int __udp_disconnect(struct sock *sk, int flags);
 int udp_disconnect(struct sock *sk, int flags);
diff --git a/net/ipv4/udp.c b/net/ipv4/udp.c
index 3ebd5765f..0ff305ee1 100644
--- a/net/ipv4/udp.c
+++ b/net/ipv4/udp.c
@@ -93,6 +93,7 @@
 #include <linux/inet.h>
 #include <linux/netdevice.h>
 #include <linux/slab.h>
+#include <linux/cache.h>
 #include <net/tcp_states.h>
 #include <linux/skbuff.h>
 #include <linux/proc_fs.h>
@@ -1522,17 +1523,17 @@ static void udp_skb_dtor_locked(struct sock *sk, struct sk_buff *skb)
  * to relieve pressure on the receive_queue spinlock shared by consumer.
  * Under flood, this means that only one producer can be in line
  * trying to acquire the receive_queue spinlock.
- * These busylock can be allocated on a per cpu manner, instead of a
- * per socket one (that would consume a cache line per socket)
+ * The lock is per socket as upstream did in 3cd04c8f4afe ("udp: make
+ * busylock per socket"), so it can be cache-line aligned and avoids the
+ * NUMA bouncing of the old global hashed array.  The pointer is kept in
+ * a KABI reserve of struct sock, leaving the ABI unchanged.
  */
-static int udp_busylocks_log __read_mostly;
-static spinlock_t *udp_busylocks __read_mostly;
+static struct kmem_cache *udp_busylock_cache __ro_after_init;
 
-static spinlock_t *busylock_acquire(void *ptr)
+static spinlock_t *busylock_acquire(struct sock *sk)
 {
-	spinlock_t *busy;
+	spinlock_t *busy = sk->sk_udp_busylock;
 
-	busy = udp_busylocks + hash_ptr(ptr, udp_busylocks_log);
 	spin_lock(busy);
 	return busy;
 }
@@ -1566,18 +1567,28 @@ int __udp_enqueue_schedule_skb(struct sock *sk, struct sk_buff *skb)
 	if (rmem > (sk->sk_rcvbuf >> 1)) {
 		skb_condense(skb);
 
+		size = skb->truesize;
+
+		/* Avoid piling too many producers on the busylock:
+		 * update sk_rmem_alloc (and bail out early on overflow)
+		 * before acquiring it. We drop only if the receive buf
+		 * is full and the receive queue contains some other skb.
+		 */
+		rmem = atomic_add_return(size, &sk->sk_rmem_alloc);
+		if (rmem > (size + (unsigned int)sk->sk_rcvbuf))
+			goto uncharge_drop;
+
 		busy = busylock_acquire(sk);
+	} else {
+		size = skb->truesize;
+
+		/* No need for the expensive atomic_add_return() when we
+		 * are not close to sk_rcvbuf.
+		 */
+		atomic_add(size, &sk->sk_rmem_alloc);
 	}
-	size = skb->truesize;
 	udp_set_dev_scratch(skb);
 
-	/* we drop only if the receive buf is full and the receive
-	 * queue contains some other skb
-	 */
-	rmem = atomic_add_return(size, &sk->sk_rmem_alloc);
-	if (rmem > (size + (unsigned int)sk->sk_rcvbuf))
-		goto uncharge_drop;
-
 	spin_lock(&list->lock);
 	if (size >= sk->sk_forward_alloc) {
 		amt = sk_mem_pages(size);
@@ -1630,6 +1641,11 @@ void udp_destruct_common(struct sock *sk)
 		kfree_skb(skb);
 	}
 	udp_rmem_release(sk, total, 0, true);
+
+	if (sk->sk_udp_busylock) {
+		kmem_cache_free(udp_busylock_cache, sk->sk_udp_busylock);
+		sk->sk_udp_busylock = NULL;
+	}
 }
 EXPORT_SYMBOL_GPL(udp_destruct_common);
 
@@ -1639,11 +1655,29 @@ static void udp_destruct_sock(struct sock *sk)
 	inet_sock_destruct(sk);
 }
 
+/* Allocate and initialise the per-socket busylock.  Called from the
+ * protocol ->init() (process context) for both IPv4 and IPv6/UDP-Lite.
+ */
+int udp_busylock_alloc(struct sock *sk)
+{
+	spinlock_t *busylock;
+
+	sk->sk_udp_busylock = NULL;
+	busylock = kmem_cache_alloc(udp_busylock_cache, GFP_KERNEL);
+	if (!busylock)
+		return -ENOMEM;
+
+	spin_lock_init(busylock);
+	sk->sk_udp_busylock = busylock;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(udp_busylock_alloc);
+
 int udp_init_sock(struct sock *sk)
 {
 	skb_queue_head_init(&udp_sk(sk)->reader_queue);
 	sk->sk_destruct = udp_destruct_sock;
-	return 0;
+	return udp_busylock_alloc(sk);
 }
 
 void skb_consume_udp(struct sock *sk, struct sk_buff *skb, int len)
@@ -3358,7 +3392,6 @@ static void __init bpf_iter_register(void)
 void __init udp_init(void)
 {
 	unsigned long limit;
-	unsigned int i;
 
 	udp_table_init(&udp_table, "UDP");
 	limit = nr_free_buffer_pages() / 8;
@@ -3367,16 +3400,18 @@ void __init udp_init(void)
 	sysctl_udp_mem[1] = limit;
 	sysctl_udp_mem[2] = sysctl_udp_mem[0] * 2;
 
-	__udp_sysctl_init(&init_net);
+	/* One cache line per socket, so producers never share a busylock
+	 * cache line across sockets/NUMA nodes.  Keep the object at least
+	 * as big as spinlock_t (debug configs can enlarge it).
+	 */
+	udp_busylock_cache = kmem_cache_create("udp_busylock",
+				max_t(unsigned int, SMP_CACHE_BYTES,
+				      sizeof(spinlock_t)),
+				0, SLAB_HWCACHE_ALIGN, NULL);
+	if (!udp_busylock_cache)
+		panic("UDP: failed to create udp_busylock cache\n");
 
-	/* 16 spinlocks per cpu */
-	udp_busylocks_log = ilog2(nr_cpu_ids) + 4;
-	udp_busylocks = kmalloc(sizeof(spinlock_t) << udp_busylocks_log,
-				GFP_KERNEL);
-	if (!udp_busylocks)
-		panic("UDP: failed to alloc udp_busylocks\n");
-	for (i = 0; i < (1U << udp_busylocks_log); i++)
-		spin_lock_init(udp_busylocks + i);
+	__udp_sysctl_init(&init_net);
 
 	if (register_pernet_subsys(&udp_sysctl_ops))
 		panic("UDP: failed to init sysctl parameters.\n");
