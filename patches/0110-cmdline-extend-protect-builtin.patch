+static bool __init cmdline_has_param(const char *cmdline, const char *token,
+				     size_t token_len)
+{
+	size_t name_len = 0;
+	const char *p = cmdline;
+
+	while (name_len < token_len && token[name_len] != '=')
+		name_len++;
+
+	if (!name_len)
+		return false;
+
+	while (*p) {
+		size_t n = 0;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+		if (!*p)
+			break;
+
+		while (p[n] && p[n] != ' ' && p[n] != '\t')
+			n++;
+
+		if (n >= name_len && !strncmp(p, token, name_len) &&
+		    (n == name_len || p[name_len] == '='))
+			return true;
+
+		p += n;
+	}
+
+	return false;
+}
